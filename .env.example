DISCORD_TOKEN=your_discord_bot_token_here
CHANNEL_ID=your_general_channel_id_here
AI_CHANNEL_ID=your_ai_news_channel_id_here

# Community Predictions
ENABLE_COMMUNITY_PREDICTIONS=true
F1_CHANNEL_ID=your_f1_channel_id_here
# MotoGP channel (schedules, reminders, results, community polls)
MOTOGP_CHANNEL_ID=1502321912133451796
API_PORT=3001

SUPABASE_URL=your_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# DGL Announcements (website → Discord automation, Phase J1)
# Read-only: uses SUPABASE_ANON_KEY + Realtime on community_activity
ENABLE_DGL_ANNOUNCEMENTS=false
DGL_ANNOUNCEMENTS_CHANNEL_ID=your_dgl_announcements_channel_id_here
# DGL_COMMUNITY_ACTIVITY_TABLE=community_activity
# DGL_CATCHUP_LIMIT=50
# DGL_CATCHUP_INTERVAL_MS=300000

# XP / Leveling (optional secondary feature — keep DISABLED until schema-xp-leveling.sql is applied)
# Emergency off-switch: set ENABLE_XP_LEVELING=false and pm2 restart jarvisdgl
ENABLE_XP_LEVELING=false
LEVEL_UP_CHANNEL_ID=your_dgl_levelup_channel_id_here
# XP_MIN=15
# XP_MAX=25
# XP_COOLDOWN_MS=60000
# XP_COOLDOWN_MAX_ENTRIES=5000
# XP_MAX_IN_FLIGHT=2

# Reddit (MotoGP community prediction threads)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=JarvisDGL/1.0
REDDIT_SUBREDDIT=MotoGPTamil
